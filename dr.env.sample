# Recovery-pack facts that no service .env holds (R23). Copy to dr.env (git-ignored), fill in,
# then run scripts/make-dr-pdf.sh. Duplicati doesn't back dr.env up: keep a copy as an
# attachment in Vaultwarden. Values print as written; leave one blank to print "(not set)".

# People
OWNER=<owner>
SUCCESSOR=<successor>               # takes over or winds down; hands Part 3 to a helper
SUCCESSOR_CONTACT=<phone, email>
HELPER=                             # a technical helper who has agreed to help; blank if none yet
HELPER_CONTACT=
EA_TYPE=View                        # Vaultwarden Emergency Access granted to SUCCESSOR: View or Takeover
EA_WAIT_DAYS=7

# Where things are
SERVER_HOSTNAME=<hostname>
SERVER_LOCATION=<room, shelf>
NAS_LOCATION=<room, shelf>
PACK_COPIES=<where the printed copies are kept>

# Main email: password resets for most accounts go here, so it is cancelled last
EMAIL_ACCOUNT=<address>
EMAIL_PASSWORD=changeme
EMAIL_2FA=<where the second factor or the recovery codes are>

# Logins that work while the server (and Vaultwarden on it) is down
SERVER_USER=<user>
SERVER_PASSWORD=changeme
NAS_ADMIN_USER=<user>
NAS_ADMIN_PASSWORD=changeme
SMB_USER=<user>                     # ~/.smbcredentials for bootstrap-host.sh
SMB_PASSWORD=changeme
JETKVM_PASSWORD=changeme
UNIFI_ADMIN_USER=<user>
UNIFI_ADMIN_PASSWORD=changeme
GITHUB_USER=<user>                  # owns the private repo
GITHUB_PASSWORD=changeme
GITHUB_2FA=<where the second factor or the recovery codes are>
REGISTRAR_USER=<user>
REGISTRAR_PASSWORD=changeme

# Backups
DUPLICATI_NAS_FULL_PASSPHRASE=changeme
DUPLICATI_OFFSITE_PASSPHRASE=       # blank until the offsite job exists (R20)
OFFSITE_PROVIDER=                   # blank until chosen

# Domain
DOMAIN_RENEWS=YYYY-MM-DD

# Accounts, in the order to cancel them (Part 2). One per line, seven fields separated by |:
# provider|what it's for|renews|cost|paid with|what stops if cancelled|action
ACCOUNT_1="<usenet provider>|Usenet downloads (nzbget)|monthly|<cost>|<card>|new downloads|Cancel"
ACCOUNT_2="<usenet indexer>|Search for downloads (Sonarr, Radarr)|YYYY-MM-DD|<cost>|<card>|new downloads|Cancel"
ACCOUNT_3="<offsite storage>|Offsite backup copy|monthly|<cost>|<card>|the offsite copy is deleted|Cancel after the data is copied off"
ACCOUNT_4="Plex|Films and TV for family|YYYY-MM-DD|<cost>|<card>|Plex Pass features|Cancel, or keep if family still watch"
ACCOUNT_5="<registrar>|The <domain> name|YYYY-MM-DD|<cost>|<card>|every <domain> address|Let it lapse, or transfer (see below)"
ACCOUNT_6="Cloudflare|DNS for <domain>|free|-|-|every <domain> address|Delete after the domain"
ACCOUNT_7="Tailscale|Owner's remote access|free|-|-|nothing others use|Delete"
ACCOUNT_8="GitHub|The server's configuration|free|-|-|the code; the server keeps running|Delete last of the technical ones"
ACCOUNT_9="UniFi|Router remote management|free|-|-|remote management only|Delete; the router keeps working"
ACCOUNT_10="JetKVM|Remote console|free|-|-|remote console only|Delete"
ACCOUNT_11="Synology|NAS remote access and updates|free|-|-|remote access only|Delete once the NAS is wiped or handed on"
ACCOUNT_12="<ISP>|Home internet, static IP|monthly|<cost>|<card>|the home internet|Keep the internet; drop the static IP add-on"
ACCOUNT_13="<email provider>|Main email|free|-|-|password resets for everything above|Close last, if at all"
