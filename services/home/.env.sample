TZ=Australia/Perth
APPDATA=/srv/appdata
# Your domain: apps answer on <app>.<domain>
DOMAIN=changeme.com

# Zigbee dongle: find it with  ls /dev/serial/by-id/
ZIGBEE_DONGLE=/dev/serial/by-id/usb-ITead_Sonoff_Zigbee_3.0_USB_Dongle_Plus_changeme-if00-port0

# A user in Mosquitto's password file (README: Mosquitto users)
Z2M_MQTT_USER=zigbee2mqtt
Z2M_MQTT_PASSWORD=changeme
# Asked for by the Zigbee2MQTT web page. Generate with: openssl rand -hex 24
Z2M_FRONTEND_TOKEN=changeme

# ESPHome dashboard login
ESPHOME_USERNAME=changeme
ESPHOME_PASSWORD=changeme
