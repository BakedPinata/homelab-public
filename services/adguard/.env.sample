APPDATA=/srv/appdata
# Your domain: apps answer on <app>.<domain>
DOMAIN=changeme.com

# Server's LAN address: DNS is published only on this IP
LAN_IP=192.168.10.103

# AdGuard admin login (same as the wizard). Used by adguardhome-sync on both instances.
ADGUARD_USERNAME=changeme
ADGUARD_PASSWORD=changeme
# Secondary on the NAS (nas/adguard): web UI and API
ADGUARD_NAS_URL=http://192.168.10.7:3053
