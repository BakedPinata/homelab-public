TZ=Australia/Perth
APPDATA=/srv/appdata
# Your domain: Gitea answers on git.<domain>
DOMAIN=changeme.com

# Git over SSH on the server's LAN address (docs/network.md)
GITEA_SSH_PORT=2222

GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
# Letters and digits only. Generate with: openssl rand -base64 36 | tr -dc 'A-Za-z0-9'
GITEA_DB_PASSWORD=changeme
