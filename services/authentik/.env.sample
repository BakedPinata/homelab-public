TZ=Australia/Perth
APPDATA=/srv/appdata
# Your domain: apps answer on <app>.<domain>
DOMAIN=changeme.com

# Generate with: openssl rand -base64 60 | tr -d '\n'   (never change it after first start)
AUTHENTIK_SECRET_KEY=changeme

AUTHENTIK_PG_DB=authentik
AUTHENTIK_PG_USER=authentik
# Generate with: openssl rand -base64 36 | tr -d '\n/+='
AUTHENTIK_PG_PASSWORD=changeme

# Gmail app password: https://myaccount.google.com/apppasswords (can be the same one BookStack uses)
AUTHENTIK_EMAIL_HOST=smtp.gmail.com
AUTHENTIK_EMAIL_PORT=587
AUTHENTIK_EMAIL_USERNAME=changeme@gmail.com
AUTHENTIK_EMAIL_PASSWORD=changeme
