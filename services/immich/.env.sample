TZ=Australia/Perth
APPDATA=/srv/appdata
# Your domain: apps answer on <app>.<domain>
DOMAIN=changeme.com

# NAS Photos share: library/ (originals), upload/, thumbs/, encoded-video/, profile/, backups/
IMMICH_PHOTOS_PATH=/media/Photos

# Keep postgres / immich: the restored dump expects that owner and database
IMMICH_DB_USER=postgres
IMMICH_DB_NAME=immich
# Letters and digits only. Generate with: openssl rand -base64 36 | tr -dc 'A-Za-z0-9'
IMMICH_DB_PASSWORD=changeme
