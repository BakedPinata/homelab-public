TZ=Australia/Perth
PUID=1000
PGID=1000
APPDATA=/srv/appdata
# Your domain: obsidian.<domain> (browser view) and couchdb.<domain> (sync)
DOMAIN=changeme.com

# CouchDB admin (setup only, never typed into Obsidian). Passwords: openssl rand -hex 24
COUCHDB_USER=changeme
COUCHDB_PASSWORD=changeme

# Sync login used by every Obsidian device (rights on the vault database only)
LIVESYNC_USER=changeme
LIVESYNC_PASSWORD=changeme
