TZ=Australia/Perth
APPDATA=/srv/appdata
# Your domain: apps answer on <app>.<domain>
DOMAIN=changeme.com

# Generate each with: openssl rand -base64 32   (store both in Vaultwarden)
# The encryption key protects Duplicati's own settings DB. Lose it and the jobs must be re-created (backups are unaffected).
DUPLICATI_SETTINGS_ENCRYPTION_KEY=changeme
DUPLICATI_UI_PASSWORD=changeme

# Inside the NAS BACKUPS share (mounted by bootstrap-host.sh)
NAS_BACKUP_PATH=/media/Backups/Duplicati

# Failure emails (R21a): Duplicati (set in its UI, see README) and scripts/notify.sh (reads these keys).
# Gmail app password: https://myaccount.google.com/apppasswords (can be the one Authentik uses)
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=465
ALERT_SMTP_USER=changeme@gmail.com
ALERT_SMTP_PASSWORD=changeme
ALERT_EMAIL_TO=changeme@example.com
