TZ=Australia/Perth
APPDATA=/srv/appdata
# Your domain: apps answer on <app>.<domain>
DOMAIN=changeme.com

# Cloudflare: My Profile → API Tokens → Create Token → "Edit zone DNS" template,
# Zone Resources = Include / Specific zone / <domain>. Store it in Vaultwarden.
CF_DNS_API_TOKEN=changeme

# Shared by Traefik's CrowdSec middleware and CrowdSec. Generate with: openssl rand -hex 32
CROWDSEC_BOUNCER_KEY=changeme
