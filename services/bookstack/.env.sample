TZ=Australia/Perth
PUID=1000
PGID=1000
APPDATA=/srv/appdata
# Your domain: apps answer on <app>.<domain>
DOMAIN=changeme.com

BOOKSTACK_PORT=6875
BOOKSTACK_ALLOWED_IFRAME_HOSTS=
# Generate with: docker run --rm --entrypoint /bin/bash lscr.io/linuxserver/bookstack:<tag> appkey
BOOKSTACK_APPKEY=changeme

# Gmail app password: https://myaccount.google.com/apppasswords
BOOKSTACK_MAIL_HOST=smtp.gmail.com
BOOKSTACK_MAIL_PORT=587
BOOKSTACK_MAIL_USERNAME=changeme@gmail.com
BOOKSTACK_MAIL_PASSWORD=changeme

# Sign-in: oidc (Authentik) or standard (BookStack's own passwords, the fallback)
BOOKSTACK_AUTH_METHOD=oidc
# Authentik → Applications → Providers → bookstack
BOOKSTACK_OIDC_CLIENT_ID=changeme
BOOKSTACK_OIDC_CLIENT_SECRET=changeme

BOOKSTACK_MARIADB_DATABASE=bookstackapp
BOOKSTACK_MARIADB_USER=bookstack
BOOKSTACK_MARIADB_PASSWORD=changeme
BOOKSTACK_MARIADB_ROOT_PASSWORD=changeme
