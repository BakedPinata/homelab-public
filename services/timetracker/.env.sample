# Your domain: apps answer on <app>.<domain>
DOMAIN=changeme.com

# The app's private repo, https form: https://github.com/<owner>/<repo>.git
TIMETRACKER_REPO=changeme
# GitHub fine-grained token: only that repo, Contents read-only (README)
TIMETRACKER_GIT_TOKEN=changeme
# Google Cloud → Google Auth Platform → Clients → the web client. Public by design (no secret is used)
TIMETRACKER_GOOGLE_CLIENT_ID=changeme
