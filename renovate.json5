// Renovate (R6): the Renovate GitHub App opens update PRs; merging one deploys it.
// Auto-merge (decided 2026-10-21): CI tooling, the tools and media stacks (minor/patch), and
// linuxserver.io rebuilds, each once the release is 3 days old. Everything else waits for the owner.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  timezone: 'Australia/Perth',
  platformAutomerge: false,  // Renovate merges once validate passes (no branch protection on a free private repo)
  customManagers: [
    {
      // Versions inside workflow run steps and scripts
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/.+\\.ya?ml$/', '/^scripts/.+\\.sh$/'],
      matchStrings: [
        '(?<depName>ghcr\\.io/gitleaks/gitleaks):(?<currentValue>v[\\d.]+)',
        'SQLITE_IMAGE=(?<depName>[\\w./-]+):(?<currentValue>[\\d.]+)',
      ],
      datasourceTemplate: 'docker',
    },
    {
      // Restore commands in service READMEs use the same image as backup-db.sh
      customType: 'regex',
      managerFilePatterns: ['/^services/.+/README\\.md$/'],
      matchStrings: ['(?<depName>keinos/sqlite3):(?<currentValue>[\\d.]+)'],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/.+\\.ya?ml$/'],
      matchStrings: ['pipx install (?<depName>yamllint)==(?<currentValue>[\\d.]+)'],
      datasourceTemplate: 'pypi',
    },
  ],
  packageRules: [
    {
      // linuxserver.io tags: <app version>[-r0|_stable_<date>]-ls<build>
      matchDatasources: ['docker'],
      matchPackageNames: ['/^lscr\\.io/linuxserver//'],
      matchCurrentValue: '/-ls\\d+$/',
      versioning: 'regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?(?:\\.(?<build>\\d+))?(?:-r\\d+|_stable_\\d{4}-\\d{2}-\\d{2})?-ls(?<revision>\\d+)$',
    },
    {
      matchPackageNames: ['plantuml/plantuml-server'],
      versioning: 'regex:^jetty-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$',
    },
    {
      matchPackageNames: ['corentinth/it-tools'],
      versioning: 'regex:^(?<major>\\d{4})\\.(?<minor>\\d+)\\.(?<patch>\\d+)-[0-9a-f]{7}$',
    },
    {
      // Server and machine learning must match
      matchPackageNames: ['/^ghcr\\.io/immich-app/immich-/'],
      groupName: 'immich',
    },
    {
      // Immich's release notes say when its database image changes
      matchPackageNames: ['ghcr.io/immich-app/postgres'],
      enabled: false,
    },
    {
      // Primary and NAS secondary stay on the same version
      matchPackageNames: ['adguard/adguardhome'],
      groupName: 'adguard home',
    },
    {
      // A database major version needs a dump and restore: approve it on the Dependency Dashboard
      matchPackageNames: ['postgres', 'lscr.io/linuxserver/mariadb', 'couchdb', 'docker.io/valkey/valkey'],
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
    {
      matchManagers: ['github-actions'],
      automerge: true,
      minimumReleaseAge: '3 days',
    },
    {
      matchDepNames: ['ghcr.io/gitleaks/gitleaks', 'keinos/sqlite3', 'yamllint'],
      automerge: true,
      minimumReleaseAge: '3 days',
    },
    {
      matchFileNames: ['services/tools/compose.yaml', 'services/media/compose.yaml'],
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
      minimumReleaseAge: '3 days',
    },
    {
      // Weekly linuxserver.io rebuilds: same app version, new -ls number
      matchDatasources: ['docker'],
      matchPackageNames: ['/^lscr\\.io/linuxserver//'],
      matchJsonata: ['$replace(currentValue, /-ls\\d+$/, "") = $replace(newValue, /-ls\\d+$/, "")'],
      groupName: 'linuxserver.io rebuilds',
      automerge: true,
      minimumReleaseAge: '3 days',
    },
  ],
}
