#!/bin/sh
# Block commits that contain .env files or anything that looks like a secret.
# Enabled by: git config core.hooksPath .githooks

if git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)[^/]*\.env$|(^|/)\.env$'; then
  echo "pre-commit: refusing to commit the .env file(s) above" >&2
  exit 1
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed (run: sudo scripts/bootstrap-host.sh)" >&2
  exit 1
fi
exec gitleaks protect --staged --redact --no-banner
